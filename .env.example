# DSView Configuration
# Copy this file to .env and fill in your values

# ================================
# LLM Provider API Keys
# ================================
# Mistral AI (recommended default)
MISTRAL_API_KEY=your_mistral_api_key_here

# OpenAI (optional)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ================================
# Database Configuration
# ================================
# PostgreSQL (recommended for production)
POSTGRES_PASSWORD=postgres_password_here

# Alternative: SQLite (for development/testing)
# DATABASE_URL=sqlite:///./dsview.db

# ================================
# Obsidian Configuration
# ================================
# Path to Obsidian vault (relative or absolute)
VAULT_PATH=./dsview_vault

# ================================
# Application Directories
# ================================
# Configuration files directory
CONF_DIR=./config

# LLM prompts directory
PROMPT_DIR=./prompts

# ================================
# MLflow Configuration (Optional)
# ================================
# MLflow tracking server (if using external server)
# MLFLOW_TRACKING_URI=http://localhost:5000

# ================================
# Vault repository
# ================================

VAULT_REPOSITORY=your_repo_here

# Git authentification
GITHUB_USERNAME=user_for_auto_updates_here
GITHUB_USER_EMAIL=user_email_for_auto_updates_here
GITHUB_TOKEN=token_for_auto_updates_here
